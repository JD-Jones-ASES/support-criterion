    (hy0 : 0 ≤ y) (hy1 : y ≤ 1) :
    0 ≤ shiftedPolynomial (9*(5+x)/160) ((0+y)/8) := by
  have hxm : 0 ≤ 1-x := sub_nonneg.mpr hx1
