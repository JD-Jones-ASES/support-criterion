      (5997 / 800 : ℝ) * x^2 * (1-x)^4 * y^0 * (1-y)^3 +
      (7945259 / 409600 : ℝ) * x^2 * (1-x)^4 * y^1 * (1-y)^2 +
      (175238878689 / 10485760000 : ℝ) * x^2 * (1-x)^4 * y^2 * (1-y)^1 +
      (51479107058057 / 10737418240000 : ℝ) * x^2 * (1-x)^4 * y^3 * (1-y)^0 +
      (1999 / 200 : ℝ) * x^3 * (1-x)^3 * y^0 * (1-y)^3 +
      (7966301 / 307200 : ℝ) * x^3 * (1-x)^3 * y^1 * (1-y)^2 +
