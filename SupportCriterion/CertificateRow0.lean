module

public import SupportCriterion.CertificateDefs

@[expose] public section

/-! Exact shifted Bernstein certificates on one row of eight closed cells. -/
set_option maxRecDepth 8192
set_option maxHeartbeats 8000000
namespace SupportCriterion

theorem shifted_cell_0_0 (x y : ℝ) (hx0 : 0 ≤ x) (hx1 : x ≤ 1)
    (hy0 : 0 ≤ y) (hy1 : y ≤ 1) :
    0 ≤ shiftedPolynomial (9*(0+x)/160) ((0+y)/8) := by
  have hxm : 0 ≤ 1-x := sub_nonneg.mpr hx1
  have hym : 0 ≤ 1-y := sub_nonneg.mpr hy1
  have hid : shiftedPolynomial (9*(0+x)/160) ((0+y)/8) =
      (1999 / 4000 : ℝ) * x^0 * (1-x)^6 * y^0 * (1-y)^3 +
      (114737 / 96000 : ℝ) * x^0 * (1-x)^6 * y^1 * (1-y)^2 +
