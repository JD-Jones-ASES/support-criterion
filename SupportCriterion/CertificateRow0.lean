      (6248529 / 4096000 : ℝ) * x^1 * (1-x)^5 * y^3 * (1-y)^0 +
      (5997 / 800 : ℝ) * x^2 * (1-x)^4 * y^0 * (1-y)^3 +
      (7393379 / 409600 : ℝ) * x^2 * (1-x)^4 * y^1 * (1-y)^2 +
      (94742613 / 6553600 : ℝ) * x^2 * (1-x)^4 * y^2 * (1-y)^1 +
      (5049491797 / 1310720000 : ℝ) * x^2 * (1-x)^4 * y^3 * (1-y)^0 +
      (1999 / 200 : ℝ) * x^3 * (1-x)^3 * y^0 * (1-y)^3 +
      (7418201 / 307200 : ℝ) * x^3 * (1-x)^3 * y^1 * (1-y)^2 +
      (10173680573 / 524288000 : ℝ) * x^3 * (1-x)^3 * y^2 * (1-y)^1 +
