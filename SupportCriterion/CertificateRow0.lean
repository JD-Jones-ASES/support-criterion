      (681867596988389 / 429496729600000 : ℝ) * x^5 * (1-x)^1 * y^3 * (1-y)^0 +
      (1999 / 4000 : ℝ) * x^6 * (1-x)^0 * y^0 * (1-y)^3 +
      (7491533 / 6144000 : ℝ) * x^6 * (1-x)^0 * y^1 * (1-y)^2 +
